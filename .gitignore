# --- Node / Next.js ---
node_modules/
.next/
.next/cache/
out/
.turbo/
.vercel/

# --- Env secrets (do NOT commit) ---
.env
.env.local
.env.*.local

# --- Package manager lockfiles ---
package-lock.json
pnpm-lock.yaml
nul

# --- VS code settings ---
.vscode/

# --- Build artifacts ---
tsconfig.tsbuildinfo

# --- Playwright ---
test-results/
playwright-report/
.playwright-mcp/

# --- Planning notes and specs (kept locally, not in the repo) ---
/docs/

# --- Stray build output ---
/dist/

# --- Claude Code local settings ---
.claude/settings.local.json
# Subagent worktrees — separate checkouts, never part of this one
.claude/worktrees/

# --- Private Discord archive: findings that cross from the vault, never committed ---
docs/discord-findings/

# Throwaway query scripts written by writing agents; never committed.
scripts/_tmp-*

# Local state for check-session-sync.mjs — records which findings existed last
# run so a withdrawal is detectable. Machine-local, never shared.
docs/discord-findings/.sync-last-seen.json
