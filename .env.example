# TAq-Website — local development environment.
#
# One set of names (TAQ-96). Every value in a developer's .env is a DEV value:
# the local Postgres mirror, the dev Discord application, the storage-dev
# bucket. Production values live only in Vercel's project variables (and, for
# one-off scripts, in the workspace vault reached through `prodctx`). There is
# no TEST_MODE and no TEST_* twin of anything: which environment a process
# talks to is decided by where it runs, never by a boolean in this file.
#
# Copy to .env and fill in. .env is gitignored; keep it that way.

# Local PostgreSQL (a prod mirror; see the dev-db notes)
DB_LOGIN=
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tortreborn
DB_SSLMODE=disable

# Sessions — 32+ random bytes each. EXEC_SESSION_SECRET also signs the wiki
# session cookie and short-lived uniform tokens.
EXEC_SESSION_SECRET=
COOKIE_SECRET=

# Discord OAuth for login (the DEV application), plus the dev bot token used
# by the exec routes that post to Discord (snipes, applications).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_BOT_TOKEN=
SNIPE_LOG_CHANNEL_ID=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Shared with the Discord bot: signs the application tokens it hands out.
APPLICATION_TOKEN_SECRET=

# Railway Bucket storage (S3 protocol) — the storage-dev bucket's own keys.
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET_NAME=

# Optional
# LE_BALANCE_DISCORD_WEBHOOK_URL=      # LE balance changes post here
# BLOB_READ_WRITE_TOKEN=               # Vercel Blob for wiki images (else S3)
# WIKI_BLOB_ACCESS=private

# Local convenience: turns every rate limiter off (in-memory, cache, shared).
# Never set on Vercel.
RATE_LIMIT_DISABLED=1
